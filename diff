#!/usr/bin/env python3
"""./diff results/A results/B  -- per-metric node-value ratios B/A from results.tsv"""
import sys, os
def load(d):
    r = {}
    for line in open(os.path.join(d, "results.tsv")):
        f = line.split()
        if f[0] == "RESULT": r[(f[1], f[2])] = (f[3], float(f[4]))
    return r
a, b = load(sys.argv[1]), load(sys.argv[2])
print(f"{'bench':<16}{'metric':<30}{'unit':<10}{'A':>12}{'B':>12}{'B/A':>8}")
for k in sorted(set(a) | set(b)):
    ua, va = a.get(k, ("", float("nan"))); ub, vb = b.get(k, ("", float("nan")))
    print(f"{k[0]:<16}{k[1]:<30}{ua or ub:<10}{va:>12.4g}{vb:>12.4g}{vb/va if va else float('nan'):>8.3f}")
